# ===========================================
# Supabase + Vercel Migration Environment
# ===========================================

# ----- SUPABASE -----
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Database connection (get from Supabase Dashboard > Settings > Database)
# Use "Connection string" > "URI" format
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# ----- AUTHENTICATION -----
# Generate a secure random string (min 32 chars)
# Example: openssl rand -base64 32
JWT_SECRET_KEY=your-secure-secret-key-min-32-chars

# Token expiration settings
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER=30

# ----- GOOGLE OAUTH -----
# Get from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# ----- OPENAI -----
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ----- TOSS PAYMENTS -----
# Get from: https://developers.tosspayments.com/
TOSS_PAYMENTS_SECRET_KEY=test_sk_...
TOSS_PAYMENTS_CLIENT_KEY=test_ck_...
TOSS_API_BASE_URL=https://api.tosspayments.com

# ----- EMAIL (Optional - for password reset) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ----- APP URLs -----
# For local development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# For production (update after Vercel deploy)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
